# AKSA Backend — Lokal Geliştirme Şablonu
# Bu dosyayı .env olarak kopyalayın ve kendi anahtarlarınızı ekleyin.

GEMINI_API_KEY=AIzaSy... (Buraya kendi anahtarınızı girin)

# SQLite (varsayılan)
DATABASE_URL=sqlite+aiosqlite:///./aksa_dev.db

# Firebase Admin SDK (Opsiyonel)
FIREBASE_CREDENTIALS_PATH=./firebase_credentials.json
